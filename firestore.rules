rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'prabhakararyan2007@gmail.com';
    }
    
    // 1. Users collection (Private profiles, playlists, favorites)
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
      allow delete: if request.auth != null && request.auth.uid == userId;
      
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read: if isAdmin();
      }
    }

    // 2. Songs collection (Music Catalogue & Creator Studio)
    match /songs/{songId} {
      // Allow everyone to read songs so catalogue streams for all users
      allow read: if true;
      
      // Allow creator uploads, stream link edits, and deletions from Studio & Dashboard
      allow create, update, delete: if true;
    }

    // 3. Deleted songs blacklist & sync registry (Ensures deleted tracks stay deleted across devices)
    match /deleted_songs/{songId} {
      allow read, write: if true;
    }
    
    // 4. Fallback rule
    match /{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
